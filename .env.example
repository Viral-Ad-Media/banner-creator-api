NODE_ENV=development
PORT=4000
GEMINI_API_KEY=
TEXT_GENERATION_PROVIDER=gemini
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MODEL=openai/gpt-5.2
OPENROUTER_VIDEO_MODEL_FAST=google/veo-3.1
OPENROUTER_VIDEO_MODEL_QUALITY=google/veo-3.1
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_NAME=Social Studio
# Comma-separated origins are supported, for example:
# CORS_ORIGIN=http://localhost:3000,https://your-web.vercel.app
CORS_ORIGIN=http://localhost:3000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Keep 0 for direct traffic. Use the verified number of trusted proxy hops only.
TRUST_PROXY_HOPS=0
# Must remain below the host's function deadline (allowed range 1000–45000).
PROVIDER_TIMEOUT_MS=40000
