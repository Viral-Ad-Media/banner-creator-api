NODE_ENV=development
PORT=4000
# Optional at startup. Gemini generation requires a valid provider key.
GEMINI_API_KEY=
TEXT_GENERATION_PROVIDER=gemini
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MODEL=openai/gpt-5.2
OPENROUTER_VIDEO_MODEL_FAST=google/veo-3.1
OPENROUTER_VIDEO_MODEL_QUALITY=google/veo-3.1
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_NAME=Social Studio
# Comma-separated origins are supported, for example:
# CORS_ORIGIN=http://localhost:3000,https://your-web.vercel.app
CORS_ORIGIN=http://localhost:3000
# Server only. Copy the pooled connection URL from the Banner Creator Neon project.
DATABASE_URL=postgresql://user:password@your-neon-host/neondb?sslmode=verify-full
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:4000
# Required for password reset emails; use a verified sender.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Offline legacy import only. Do not set this in production runtime.
# SOURCE_DATABASE_URL=

# Keep 0 for direct traffic. Use the verified number of trusted proxy hops only.
TRUST_PROXY_HOPS=0
# Must remain below the host's function deadline (allowed range 1000–45000).
PROVIDER_TIMEOUT_MS=40000
