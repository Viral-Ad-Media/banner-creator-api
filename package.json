{
  "name": "banner-creator-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --loader ts-node/esm src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "check": "npm run typecheck && npm run test && npm run build",
    "reconcile": "node --import tsx src/reconcile.ts",
    "test": "node --no-wasm-tier-up --import tsx --test test/*.test.ts",
    "db:migrate": "node --import tsx src/migrate.ts",
    "db:import-legacy": "node --import tsx src/importLegacyMain.ts"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "bcryptjs": "3.0.3",
    "better-auth": "1.7.17",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "0.2.18",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.14.0",
    "@types/pg": "8.23.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
